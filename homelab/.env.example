# Copie ce fichier en ".env" (cp .env.example .env), puis : chmod 600 .env

# Accès SFTP MineStrator (le même que pour GitHub)
SFTP_HOST=
SFTP_PORT=
SFTP_USER=
SFTP_PASSWORD=
# Dossier du serveur sur le SFTP, si server.properties n'est pas à la racine
SFTP_ROOT=

# Zone à dessiner : « auto » suit la bordure du monde (10 000 minimum) ; un nombre = carré fixe de ±MAP_RADIUS autour du centre
MAP_CENTER_X=0
MAP_CENTER_Z=0
MAP_RADIUS=auto

# Fuseau horaire des journaux
TZ=Europe/Paris

# Rythme et ressources
INTERVAL_MINUTES=60
# Marqueurs du mod Sumenium Economy (boutiques, FISC, HDV) relus et fusionnés toutes les N minutes
MARKERS_MINUTES=5
# Distance de caméra (blocs) au-delà de laquelle les marqueurs de boutiques disparaissent
MARKERS_MAX_DISTANCE=100000
RENDER_THREADS=8
JAVA_XMX=6G
CARTE_CPUS=8

# Apparence
MAP_NAME=Suménium · Overworld
# Couleur du brouillard hors bordure (r,g,b)
FOG_COLOR=18,30,22
